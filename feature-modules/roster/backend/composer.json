{
    "name": "staff-roster/staff-roster-module",
    "description": "Staff Roster Management Module for Laravel + Vue projects",
    "type": "library",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "StaffRoster\\StaffRosterModule\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StaffRoster\\StaffRosterModule\\StaffRosterServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
