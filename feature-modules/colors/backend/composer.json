{
    "name": "colors/colors-module",
    "description": "Complete color management system with basic and custom colors for Laravel + Vue projects",
    "type": "library",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Colors\\ColorsModule\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Colors\\ColorsModule\\ColorsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
